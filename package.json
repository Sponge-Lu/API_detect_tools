{
  "name": "api-hub-management-tools",
  "version": "3.1.5",
  "description": "API Hub Management Tools - Professional API management and monitoring tool",
  "author": {
    "name": "API Hub Team",
    "email": "support@apihub.com"
  },
  "main": "dist/main/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "prepare:sqlite": "pwsh -NoProfile -File scripts/prepare-sqlite.ps1",
    "test:artifacts": "node scripts/run-node-module.cjs typescript/bin/tsc -p tsconfig.storage-tests.json && node --test .cache/storage-tests/scripts/packaged-smoke-artifacts.test.js",
    "test:storage": "node scripts/run-node-module.cjs typescript/bin/tsc -p tsconfig.storage-tests.json && node .cache/storage-tests/scripts/run-storage-tests.js",
    "verify:storage:packaged": "node scripts/run-node-module.cjs typescript/bin/tsc -p tsconfig.storage-tests.json && node .cache/storage-tests/scripts/package-storage-smoke.js",
    "verify:storage:product": "npm run build && node scripts/run-node-module.cjs typescript/bin/tsc -p tsconfig.storage-tests.json && node .cache/storage-tests/scripts/package-product-storage-smoke.js",
    "predev": "node scripts/dev-cleanup.cjs",
    "dev": "node scripts/dev.cjs",
    "dev:main": "node scripts/dev-main.cjs",
    "dev:renderer": "vite --strictPort",
    "preview": "npm run build:renderer && node scripts/dev-main.cjs --preview",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/prepare-native.cjs && node scripts/run-node-module.cjs typescript/bin/tsc -p tsconfig.main.json && node scripts/build-preload.cjs",
    "build:renderer": "node scripts/run-node-module.cjs typescript/bin/tsc && node scripts/run-node-module.cjs vite/bin/vite.js build",
    "repair:legacy-accounts": "node scripts/repair-legacy-accounts.cjs",
    "migrate:config-v224-to-v301": "node scripts/migrate-config-v224-to-v301.cjs",
    "fetch:chromium": "node scripts/fetch-chromium.mjs",
    "verify:packaged": "node scripts/smoke-bundled-browser.cjs --verify-app",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "axios": "^1.6.0",
    "better-sqlite3": "11.10.0",
    "electron-log": "^5.4.3",
    "jsonc-parser": "^3.3.1",
    "puppeteer-core": "^21.0.0",
    "webdav": "^5.8.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "28.3.3",
    "electron-builder": "^24.0.0",
    "esbuild": "0.21.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^4.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.7",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.14",
    "zustand": "^5.0.8"
  },
  "build": {
    "buildVersion": "3.1.5",
    "beforePack": "scripts/before-pack.cjs",
    "appId": "com.apihub.management",
    "productName": "API Hub Management Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "!**/*.map",
      "!**/*.md"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName} Setup ${buildVersion}-${arch}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${buildVersion}-${arch}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${buildVersion}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${buildVersion}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${buildVersion}-linux-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${buildVersion}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "${productName}-${buildVersion}-linux-${arch}.deb"
    },
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "icon.ico"
        ]
      },
      {
        "from": "resources/chromium/${os}-${arch}",
        "to": "chromium/${os}-${arch}",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
